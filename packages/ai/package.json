{
  "name": "@inkpi/ai",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "generate:models": "node scripts/generate-models.ts",
    "hydrate:model-data": "node scripts/hydrate-model-data.ts",
    "clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@inkpi/protocol": "workspace:*"
  },
  "description": "Unified multi-provider AI engine with 4-level prompt caching, streaming recovery, and model catalog",
  "author": "InkPi Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeiSiristhebest/inkpi.git"
  },
  "bugs": {
    "url": "https://github.com/MeiSiristhebest/inkpi/issues"
  },
  "homepage": "https://github.com/MeiSiristhebest/inkpi#readme"
}
