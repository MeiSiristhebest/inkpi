{
  "name": "@inkpi/ai",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:models": "node scripts/generate-models.mjs",
    "hydrate:model-data": "node scripts/generate-models.mjs --data-only",
    "check:model-data": "node scripts/check-model-data.mjs",
    "build": "node scripts/check-model-data.mjs && tsc -b",
    "clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\""
  },

  "dependencies": {
    "@inkpi/protocol": "*"
  }
}
