{
  "name": "@inkpi/creative-agent",
  "version": "1.0.0",
  "description": "InkPi - Extensible AI Agent Harness & Workstation Platform (Inspired by Pi Architecture)",
  "type": "module",
  "bin": {
    "inkpi": "./bin/inkpi.js"
  },
  "files": [
    "bin",
    "README.md",
    "package.json"
  ],
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@inkpi/agent-core": "workspace:*",
    "@inkpi/ai": "workspace:*",
    "@inkpi/cli": "workspace:*",
    "@inkpi/client": "workspace:*",
    "@inkpi/editor-core": "workspace:*",
    "@inkpi/protocol": "workspace:*",
    "@inkpi/server": "workspace:*",
    "@inkpi/session-backends": "workspace:*",
    "@inkpi/storage": "workspace:*",
    "@inkpi/evals": "workspace:*",
    "@inkpi/tui": "workspace:*"
  },
  "scripts": {
    "inkpi": "node ./bin/inkpi.js",
    "build": "tsc -b",
    "build:offline": "tsc -b",
    "generate:models": "pnpm --filter @inkpi/ai run generate:models",
    "hydrate:model-data": "pnpm --filter @inkpi/ai run hydrate:model-data",
    "bundle": "node scripts/bundle.ts",
    "build:binaries": "node scripts/build-binaries.mjs",
    "check:pinned-deps": "node scripts/check-pinned-deps.mjs",
    "lint": "biome check packages tests scripts",
    "format": "biome format --write packages tests scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run check:pinned-deps && tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.13.0",
    "@vitest/coverage-v8": "3.0.5",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
